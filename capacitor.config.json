{
  "appId": "com.thwaphockey.app",
  "appName": "Thwap Hockey",
  "webDir": "www",
  "server": {
    "url": "https://thwaphockey.com",
    "cleartext": false,
    "allowNavigation": [
      "thwaphockey.com",
      "www.thwaphockey.com"
    ]
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0b0f14"
  },
  "android": {
    "backgroundColor": "#0b0f14"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
